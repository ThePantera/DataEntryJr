{
  "name": "@bartender-lab/mobile",
  "version": "1.0.0",
  "private": true,
  "description": "App móvil de BARTENDER LAB (Expo + React Native). Funciona sin conexión con el catálogo incorporado.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prebuild:android": "expo prebuild --platform android --clean",
    "apk": "bash scripts/build-apk.sh",
    "ios": "expo run:ios",
    "smoke:web": "node scripts/web-smoke.mjs"
  },
  "devDependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@types/react": "~19.1.17",
    "playwright": "1.63.0",
    "react-dom": "19.1.0",
    "react-native-web": "~0.21.0"
  },
  "dependencies": {
    "@bartender-lab/client-core": "0.1.0",
    "@bartender-lab/shared": "0.1.0",
    "@expo/vector-icons": "^15.0.3",
    "@tanstack/react-query": "^5.105.0",
    "expo": "~54.0.38",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-font": "~14.0.12",
    "expo-keep-awake": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-network": "~8.0.8",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0"
  }
}
