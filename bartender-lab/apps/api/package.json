{
  "name": "@bartender-lab/api",
  "version": "0.1.0",
  "private": true,
  "description": "API REST de BARTENDER LAB (NestJS + Prisma + PostgreSQL).",
  "scripts": {
    "prebuild": "npm run build -w @bartender-lab/shared",
    "build": "prisma generate && nest build",
    "pretypecheck": "npm run build -w @bartender-lab/shared",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "pretest": "npm run build -w @bartender-lab/shared && prisma generate",
    "test": "jest",
    "pretest:e2e": "npm run build -w @bartender-lab/shared && prisma generate",
    "test:e2e": "jest --config test/jest-e2e.config.js --runInBand",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "manifest:rebuild": "tsx scripts/rebuild-manifest.ts",
    "openapi:export": "npm run build && node dist/scripts/export-openapi.js"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.8",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "prisma": "^6.19.3",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "@bartender-lab/shared": "^0.1.0",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "^6.19.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  }
}
