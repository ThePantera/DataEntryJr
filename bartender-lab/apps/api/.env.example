# Copiar a .env y ajustar. Nunca subir .env al repositorio.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://bartender:bartender@localhost:5432/bartender_lab?schema=public

# Secreto para firmar los access tokens (mínimo 32 caracteres). Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-of-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Coste de scrypt (log2 N). Mínimo 17 en producción (~0,5 s por hash); se puede bajar en desarrollo.
PASSWORD_HASH_COST=17

# Límites de peticiones (por IP): global y para /auth/*.
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
AUTH_THROTTLE_LIMIT=10

# Orígenes permitidos para CORS (coma-separados). Vacío = sin CORS (la app móvil no lo necesita).
CORS_ORIGINS=
# Poner a 1 si la API corre detrás de un proxy inverso (para obtener la IP real del cliente).
TRUST_PROXY=0
# Habilita /api/docs (Swagger). Recomendado 0 en producción si no se quiere exponer.
SWAGGER_ENABLED=1

# Opcional: crea/asegura un administrador al ejecutar el seed.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
